{
  "1": {
    "inputs": {
      "unet_name": "z_image_turbo_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model (Z-Image Turbo)" }
  },
  "2": {
    "inputs": {
      "clip_name": "qwen_3_4b_fp8_mixed.safetensors",
      "type": "lumina2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP (Qwen3-4B)" }
  },
  "3": {
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE" }
  },
  "4": {
    "inputs": {
      "shift": 3.0,
      "model": ["1", 0]
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "Model Sampling (AuraFlow)" }
  },
  "5": {
    "inputs": {
      "text": "PARAM_PROMPT",
      "clip": ["2", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "CLIP Text Encode (Prompt)" }
  },
  "6": {
    "inputs": {
      "conditioning": ["5", 0]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Conditioning (Zero Out)" }
  },
  "7": {
    "inputs": {
      "width": "PARAM_INT_WIDTH",
      "height": "PARAM_INT_HEIGHT",
      "batch_size": 1
    },
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "Empty Latent Image (SD3)" }
  },
  "8": {
    "inputs": {
      "seed": "PARAM_INT_SEED",
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler" }
  },
  "9": {
    "inputs": {
      "samples": ["8", 0],
      "vae": ["3", 0]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "10": {
    "inputs": {
      "filename_prefix": "z-image-turbo",
      "images": ["9", 0]
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
